# Backend NestJS
NEXT_PUBLIC_NEST_API_URL=http://localhost:3333

# Dirección pública del sistema, la que se codifica en los QR de pedidos
# online (docs/features/pedidos-online-qr/). Sin esto se usa el origin desde
# el que navega el admin — que en desarrollo es localhost o una IP de red
