# Local (stack docker de docs/infrastructure/docker-compose.yml — puerto 54322, NO 5432):
# DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Producción/hosted: connection string de tu Postgres
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# Fase 7 — NestJS emite y valida sus propios JWT. Generar con
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`,
# nunca reusar el mismo valor entre entornos.
JWT_SECRET="replace-me"
JWT_EXPIRES_IN="10h"

# Solo para Storage (Fase 5) — subida de imágenes de producto, se mantiene
# Supabase Storage como proveedor a propósito.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-me"

PORT=3333
FRONTEND_URL="http://localhost:3000"

# Cuántos reverse proxies hay DELANTE de este backend. Decide de dónde se lee
# la IP real del cliente (X-Forwarded-For) y con eso si el rate limit de
# pedidos online por QR es por cliente o global.
#   0 → sin proxy (default, y lo correcto en desarrollo local)
#   1 → nginx/Apache o el proxy del hosting delante de Node (VPS de Hostinger)
#   2 → Cloudflare u otro CDN delante de ese nginx
# El número tiene que coincidir EXACTO con la realidad. Es un conteo de saltos
# y no un true/false a propósito: confiar en todo el header lo vuelve
# falsificable y el límite deja de existir. De menos = límite global (molesto);
# de más = límite inexistente (agujero). Ver backend/src/main.ts.
TRUST_PROXY_HOPS=0

# Fase 4 — secreto compartido entre NestJS y el servicio Spring (llamadas
# server-to-server: runtime-config, system-prompt, agent-token).
PIPPO_INTERNAL_TOKEN="replace-me"

# Fase 9 — NestJS reenvía los mensajes del widget de chat al servicio Spring.
AI_ORCHESTRATOR_URL="http://localhost:8090"

# Fase 8 — cifra las API keys de proveedores cloud guardadas en ai_models.
# Generar con `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`,
# nunca reusar el mismo valor entre entornos.
AI_MODELS_ENCRYPTION_KEY="replace-me"

# Chat IA por Telegram (docs/features/chat-ia-backend/plan-integracion-telegram.md) —
# URL pública HTTPS de este backend, usada para registrar el webhook de
# Telegram (setWebhook) cuando un negocio activa chat_ia_enabled. En local
# necesita un túnel (ngrok o similar); sin esto, activar el switch falla.
BACKEND_PUBLIC_URL="https://your-backend.example.com"
