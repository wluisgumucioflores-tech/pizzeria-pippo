// Prisma schema — refleja a mano las tablas del Supabase de DESARROLLO,
// reseteado 2026-08-09 con el schema multitenant-first (ver
// docs/database/migrations/multitenant/001_initial_schema_multitenant.sql).
// `business_id` es NOT NULL desde el día 1 en este entorno — a diferencia
// del enfoque incremental (nullable → backfill → NOT NULL) que sí aplica
// a producción, ver docs/plans/2026-06-09-multitenant-f0-f1-foundations.md.
//
// No se corrió `prisma db pull` — se mantiene a mano para conservar los
// nombres de modelo/relación ya usados en el código del backend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  name              String
  address           String?
  phone             String?
  createdAt         DateTime @default(now()) @map("created_at")
  isActive          Boolean  @default(true) @map("is_active")
  expectedStartTime String?  @map("expected_start_time")

  business                  Business                   @relation(fields: [businessId], references: [id])
  profiles                  Profile[]
  orders                    Order[]
  promotions                Promotion[]
  branchPrices              BranchPrice[]
  branchStock               BranchStock[]
  stockMovements            StockMovement[]
  branchProductStock        BranchProductStock[]
  productStockMovements     ProductStockMovement[]
  warehouseMovements        WarehouseMovement[]
  warehouseProductMovements WarehouseProductMovement[]
  devices                   Device[]
  employees                 Employee[]
  attendanceRecords         AttendanceRecord[]

  @@map("branches")
}

model Employee {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  fullName       String   @map("full_name")
  position       String
  credentialHash String   @map("credential_hash")
  manualCodeHash String   @map("manual_code_hash")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  business          Business           @relation(fields: [businessId], references: [id])
  branch            Branch             @relation(fields: [branchId], references: [id])
  attendanceRecords AttendanceRecord[]

  @@map("employees")
}

model AttendanceRecord {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  type       String
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@map("attendance_records")
}

model Device {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  branchId   String    @map("branch_id") @db.Uuid
  name       String
  apiKeyHash String    @map("api_key_hash")
  isActive   Boolean   @default(true) @map("is_active")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@map("devices")
}

model McpApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  apiKeyHash String    @map("api_key_hash")
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("mcp_api_keys")
}

model Business {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  enabledModules Json     @default("{\"kitchen\":true,\"stock\":true,\"employees\":true,\"telegram\":false,\"printer\":true,\"mesero\":false,\"mcpSaas\":false,\"aiChat\":false}") @map("enabled_modules")
  // Optional: aiChat is a per-business feature flag (enabledModules.aiChat) —
  // a business that never turns it on doesn't need a plan assigned.
  aiChatPlanId   String?  @map("ai_chat_plan_id") @db.Uuid

  aiChatPlan                AiChatPlan?                @relation(fields: [aiChatPlanId], references: [id])
  aiChatUsage               AiChatUsage[]
  profiles                  Profile[]
  appSettings               AppSetting[]
  branches                  Branch[]
  employees                 Employee[]
  devices                   Device[]
  mcpApiKeys                McpApiKey[]
  variantTypes              VariantType[]
  ingredients               Ingredient[]
  products                  Product[]
  productVariants           ProductVariant[]
  warehouseStock            WarehouseStock[]
  warehouseMovements        WarehouseMovement[]
  warehouseProductStock     WarehouseProductStock[]
  warehouseProductMovements WarehouseProductMovement[]
  promotions                Promotion[]
  promotionRules            PromotionRule[]
  categories                Category[]

  @@map("businesses")
}

// Catálogo de planes del Chat IA (administrable por superadmin desde
// /ai-chat-plans). `limits` es JSON para poder agregar nuevos tipos de
// límite a futuro (ej. modelos permitidos, ver AiModel) sin otra migración.
model AiChatPlan {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  limits    Json     @default("{}")
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  businesses Business[]

  @@map("ai_chat_plans")
}

// Uso diario (mensajes + tokens) del Chat IA por negocio. Mismo patrón
// date-keyed que TelegramUsage: una fila nueva por día, sin cron.
model AiChatUsage {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  date         DateTime @db.Date
  messageCount Int      @default(0) @map("message_count")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  updatedAt    DateTime @default(now()) @map("updated_at")

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, date])
  @@map("ai_chat_usage")
}

model Category {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  isPizza    Boolean  @default(false) @map("is_pizza")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business  @relation(fields: [businessId], references: [id])
  products Product[]

  @@map("categories")
}

model Profile {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isBanned     Boolean  @default(false) @map("is_banned")
  role         String
  branchId     String?  @map("branch_id") @db.Uuid
  fullName     String?  @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at")
  // Nullable solo para role = 'superadmin' — un superadmin no pertenece a
  // ningún negocio. Para cualquier otro rol, la BD lo exige (CHECK
  // profiles_business_id_required_unless_superadmin, ver
  // docs/database/migrations/multitenant/002_superadmin_role.sql).
  businessId   String?  @map("business_id") @db.Uuid

  branch     Branch?   @relation(fields: [branchId], references: [id])
  business   Business? @relation(fields: [businessId], references: [id])
  orders     Order[]   @relation("OrderCashier")
  paidOrders Order[]   @relation("OrderPaidBy")

  @@map("profiles")
}

model AppSetting {
  key        String
  value      String   @default("")
  updatedAt  DateTime @default(now()) @map("updated_at")
  // La columna real es nullable (multi-tenant "a medias"), pero en la
  // práctica toda fila existente ya tiene business_id — Prisma exige un
  // campo requerido para poder usarlo en un @@unique compuesto. El service
  // siempre resuelve y escribe el business_id del usuario autenticado.
  businessId String   @map("business_id") @db.Uuid

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, key])
  @@map("app_settings")
}

// Catálogo global de modelos de IA disponibles (administrable por superadmin).
// El servicio orquestador resuelve qué modelo usar consultando esta tabla vía
// NestJS. Fase 8: las API keys de proveedores cloud se guardan acá,
// cifradas (AES-256-GCM, ver common/utils/secret-crypto.ts) — nunca en texto
// plano, nunca devueltas al frontend (solo un booleano has_api_key).
model AiModel {
  id        String   @id @default(uuid()) @db.Uuid
  provider  String
  modelId   String   @map("model_id")
  label     String
  baseUrl   String?  @map("base_url")
  apiKey    String?  @map("api_key")
  isLocal   Boolean  @default(false) @map("is_local")
  isActive  Boolean  @default(true) @map("is_active")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_models")
}

// Catálogo global de system prompts del agente del chat-ia (administrable por
// superadmin). El servicio orquestador pide el prompt vigente en cada turno
// de chat — editar una fila acá cambia el comportamiento del agente sin
// recompilar ni reiniciar ningún proceso.
model AiPrompt {
  id        String   @id @default(uuid()) @db.Uuid
  locale    String   @unique
  content   String
  updatedAt DateTime @default(now()) @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_prompts")
}

model TelegramAuthorizedChat {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @unique @map("chat_id")
  type      String
  label     String   @default("")
  plan      String   @default("basic")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("telegram_authorized_chats")
}

model TelegramUsage {
  id           String   @id @default(uuid()) @db.Uuid
  chatId       String   @map("chat_id")
  date         DateTime @db.Date
  messageCount Int      @default(0) @map("message_count")
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@unique([chatId, date])
  @@map("telegram_usage")
}

model Ingredient {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String
  unit        String
  createdAt   DateTime @default(now()) @map("created_at")
  isActive    Boolean  @default(true) @map("is_active")
  isSharedUse Boolean  @default(false) @map("is_shared_use")

  business           Business            @relation(fields: [businessId], references: [id])
  recipes            Recipe[]
  branchStock        BranchStock[]
  warehouseStock     WarehouseStock?
  stockMovements     StockMovement[]
  warehouseMovements WarehouseMovement[]

  @@map("ingredients")
}

model VariantType {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime? @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@map("variant_types")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String
  // Legado: espejo best-effort derivado de categoryRef.isPizza ('pizza' o
  // null), ya no es la fuente de verdad. Se mantiene solo para lo poco que
  // todavía lo lee (combo builder, motor de promociones) — ver categoryId.
  category    String?
  categoryId  String?  @map("category_id") @db.Uuid
  description String?
  imageUrl    String?  @map("image_url")
  productType String   @default("made") @map("product_type")
  createdAt   DateTime @default(now()) @map("created_at")
  isActive    Boolean  @default(true) @map("is_active")

  business    Business         @relation(fields: [businessId], references: [id])
  categoryRef Category?        @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  name       String
  basePrice  Decimal  @map("base_price")
  createdAt  DateTime @default(now()) @map("created_at")
  isActive   Boolean  @default(true) @map("is_active")

  business           Business                   @relation(fields: [businessId], references: [id])
  product            Product                    @relation(fields: [productId], references: [id])
  branchPrices       BranchPrice[]
  recipes            Recipe[]
  orderItems         OrderItem[]
  orderItemFlavors   OrderItemFlavor[]
  promotionRules     PromotionRule[]
  branchStock        BranchProductStock[]
  stockMovements     ProductStockMovement[]
  warehouseStock     WarehouseProductStock?
  warehouseMovements WarehouseProductMovement[]

  @@map("product_variants")
}

model BranchPrice {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  price     Decimal
  createdAt DateTime @default(now()) @map("created_at")

  branch  Branch         @relation(fields: [branchId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("branch_prices")
}

model Recipe {
  id             String  @id @default(uuid()) @db.Uuid
  variantId      String  @map("variant_id") @db.Uuid
  ingredientId   String  @map("ingredient_id") @db.Uuid
  quantity       Decimal
  applyCondition String  @default("always") @map("apply_condition")

  variant    ProductVariant @relation(fields: [variantId], references: [id])
  ingredient Ingredient     @relation(fields: [ingredientId], references: [id])

  @@map("recipes")
}

model BranchStock {
  id           String   @id @default(uuid()) @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  quantity     Decimal  @default(0)
  minQuantity  Decimal  @default(0) @map("min_quantity")
  updatedAt    DateTime @default(now()) @map("updated_at")

  branch     Branch     @relation(fields: [branchId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("branch_stock")
}

model StockMovement {
  id           String   @id @default(uuid()) @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  quantity     Decimal
  type         String
  origin       String?
  notes        String?
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  branch     Branch     @relation(fields: [branchId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("stock_movements")
}

model BranchProductStock {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  quantity    Decimal  @default(0)
  minQuantity Decimal  @default(0) @map("min_quantity")
  updatedAt   DateTime @default(now()) @map("updated_at")

  branch  Branch         @relation(fields: [branchId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([branchId, variantId])
  @@map("branch_product_stock")
}

model ProductStockMovement {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Decimal
  type      String
  notes     String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  branch  Branch         @relation(fields: [branchId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("product_stock_movements")
}

model WarehouseStock {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  ingredientId String   @unique @map("ingredient_id") @db.Uuid
  quantity     Decimal  @default(0)
  minQuantity  Decimal  @default(0) @map("min_quantity")
  updatedAt    DateTime @default(now()) @map("updated_at")

  business   Business   @relation(fields: [businessId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("warehouse_stock")
}

model WarehouseMovement {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  quantity     Decimal
  type         String
  branchId     String?  @map("branch_id") @db.Uuid
  notes        String?
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  business   Business   @relation(fields: [businessId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])

  @@map("warehouse_movements")
}

model WarehouseProductStock {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  variantId   String   @unique @map("variant_id") @db.Uuid
  quantity    Decimal  @default(0)
  minQuantity Decimal  @default(0) @map("min_quantity")
  updatedAt   DateTime @default(now()) @map("updated_at")

  business Business       @relation(fields: [businessId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@map("warehouse_product_stock")
}

model WarehouseProductMovement {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  quantity   Decimal
  type       String
  branchId   String?  @map("branch_id") @db.Uuid
  notes      String?
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  business Business       @relation(fields: [businessId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])
  branch   Branch?        @relation(fields: [branchId], references: [id])

  @@map("warehouse_product_movements")
}

model Promotion {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  type       String
  daysOfWeek Int[]    @map("days_of_week")
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  branchId   String?  @map("branch_id") @db.Uuid
  active     Boolean  @default(true)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business        @relation(fields: [businessId], references: [id])
  branch   Branch?         @relation(fields: [branchId], references: [id])
  rules    PromotionRule[]

  @@map("promotions")
}

model PromotionRule {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  promotionId     String   @map("promotion_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  buyQty          Int?     @map("buy_qty")
  getQty          Int?     @map("get_qty")
  discountPercent Decimal? @map("discount_percent")
  comboPrice      Decimal? @map("combo_price")
  category        String?
  variantSize     String?  @map("variant_size")

  business  Business        @relation(fields: [businessId], references: [id])
  promotion Promotion       @relation(fields: [promotionId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("promotion_rules")
}

model Order {
  id              String    @id @default(uuid()) @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  cashierId       String    @map("cashier_id") @db.Uuid
  // Quién cobró la orden — no siempre es cashierId (cobro diferido: un
  // mesero crea la orden, un cajero distinto la cobra después). Null
  // mientras esté pendiente de cobro.
  paidById        String?   @map("paid_by") @db.Uuid
  total           Decimal
  createdAt       DateTime  @default(now()) @map("created_at")
  kitchenStatus   String    @default("pending") @map("kitchen_status")
  dailyNumber     Int       @default(0) @map("daily_number")
  paymentMethod   String?   @map("payment_method")
  paymentProvider String?   @map("payment_provider")
  orderType       String    @default("dine_in") @map("order_type")
  tableNumber     String?   @map("table_number")
  waiterName      String?   @map("waiter_name")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  cancelReason    String?   @map("cancel_reason")
  notes           String?   @map("notes")
  idempotencyKey  String?   @unique @map("idempotency_key")
  lastReadyAt     DateTime? @map("last_ready_at")

  branch   Branch         @relation(fields: [branchId], references: [id])
  cashier  Profile        @relation("OrderCashier", fields: [cashierId], references: [id])
  paidBy   Profile?       @relation("OrderPaidBy", fields: [paidById], references: [id])
  items    OrderItem[]
  payments OrderPayment[]

  @@map("orders")
}

model OrderPayment {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  method    String
  amount    Decimal
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_payments")
}

model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  qty             Int
  unitPrice       Decimal  @map("unit_price")
  discountApplied Decimal  @default(0) @map("discount_applied")
  qtyPhysical     Int      @default(1) @map("qty_physical")
  promoLabel      String?  @map("promo_label")
  priceEdited     Boolean  @default(false) @map("price_edited")
  createdAt       DateTime @default(now()) @map("created_at")

  order   Order             @relation(fields: [orderId], references: [id])
  variant ProductVariant    @relation(fields: [variantId], references: [id])
  flavors OrderItemFlavor[]
  extras  OrderItemExtra[]

  @@map("order_items")
}

model OrderItemFlavor {
  id          String  @id @default(uuid()) @db.Uuid
  orderItemId String  @map("order_item_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  proportion  Decimal @default(0.5)

  orderItem OrderItem      @relation(fields: [orderItemId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_item_flavors")
}

model OrderItemExtra {
  id          String   @id @default(uuid()) @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  name        String
  price       Decimal  @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("order_item_extras")
}
